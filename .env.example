# Database — local dev usa SQLite; en Railway/prod usá PostgreSQL.
# Local (default):
DATABASE_URL="file:./dev.db"
# Producción ejemplo:
# DATABASE_URL="postgresql://user:pass@host:5432/souverain?schema=public"

# Stripe
STRIPE_SECRET_KEY="sk_test_xxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxx"

# Modo de checkout: "stripe" | "whatsapp"
CHECKOUT_MODE="stripe"

# WhatsApp (solo dígitos, formato internacional sin '+')
WHATSAPP_NUMBER="5491157581269"

# Admin
ADMIN_PASSWORD="cambiar-en-produccion"
ADMIN_SESSION_SECRET="cambiar-este-secreto-largo-aleatorio-min-32-chars"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Distribuidora Souverain"

# Video del hero de la home (opcional). Si está vacío, queda la foto como hoy.
# Sugerido: MP4 H.264, 1080p, 8-15 segundos, loop limpio, < 6 MB, mute.
NEXT_PUBLIC_HERO_VIDEO_URL=""
